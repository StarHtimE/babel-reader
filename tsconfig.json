{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2021"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "importHelpers": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
